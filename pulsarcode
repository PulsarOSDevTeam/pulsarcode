matrix_line() {
    local width="$1"
    local chars="01PULSARCODEKIMINIMVECTORLOCAL"
    local out=""
    local idx=0
    if (( width > 96 )); then width=96; fi
    if (( width < 42 )); then width=42; fi
    for ((i = 0; i < width; i++)); do
        idx=$((RANDOM % ${#chars}))
        out+="${chars:idx:1}"
    done
    printf '%s\n' "$out"
}

matrix_intro() {
    if [[ "${PULSAR_NO_ANIMATION:-0}" == "1" || -n "${NO_COLOR:-}" || ! -t 2 ]]; then
        return 0
    fi
    local argv=" $* "
    if [[ "$argv" == *" --version "* || "$argv" == *" -v "* || "$argv" == *" --help "* || "$argv" == *" -h "* || "$argv" == *" -p "* || "$argv" == *" --print "* ]]; then
        return 0
    fi
    local cols
    cols="$(tput cols 2>/dev/null || printf '80')"
    local width=$((cols - 6))
    printf '\033[?25l' >&2
    for frame in $(seq 1 12); do
        printf '\033[38;5;34m%s\033[0m\r' "$(matrix_line "$width")" >&2
        sleep 0.025
    done
    printf '\033[2K\r' >&2
    printf '\033[38;5;46m%s\033[0m\n' "pulsarcode online: local terminal shell linked to NVIDIA NIM" >&2
    printf '\033[?25h' >&2
}

mask_key_source() {
    local key="$1"
    if (( ${#key} <= 12 )); then
        printf '%s' "present"
        return 0
    fi
    printf '%s...%s' "${key:0:8}" "${key: -4}"
}

current_nim_key() {
    if [[ -n "${NVIDIA_NIM_API_KEY:-}" ]]; then
        printf '%s' "$NVIDIA_NIM_API_KEY"
        return 0
    fi
    if [[ -n "${NVIDIA_NIM_KEY:-}" ]]; then
        printf '%s' "$NVIDIA_NIM_KEY"
        return 0
    fi
    if [[ -n "${NVIDIA_API_KEY:-}" ]]; then
        printf '%s' "$NVIDIA_API_KEY"
        return 0
    fi
    if [[ -f "$NIM_KEY_FILE" ]]; then
        tr -d '\r\n' < "$NIM_KEY_FILE"
        return 0
    fi
    return 1
}

print_api_panel() {
    local reason="${1:-manual update}"
    local key_state="not stored"
    local existing=""
    existing="$(current_nim_key 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then
        key_state="$(mask_key_source "$existing")"
    fi
    cat <<API_PANEL >&2

+------------------------------------------------------------------------------+
| pulsarcode API Core                                                           |
| NVIDIA NIM key setup for the default Kimi K2.6 route                          |
+------------------------------------------------------------------------------+
 Trigger          : $reason
 Runtime model    : $NIM_MODEL_ID
 Local alias      : $NIM_PUBLIC_MODEL
 API endpoint     : $NIM_API_BASE/chat/completions
 Stored key       : $key_state
 Key file         : $NIM_KEY_FILE

 Steps:
  1. Open $NIM_MODEL_URL
  2. Sign in. If you do not have an NVIDIA account, create one from that page.
  3. On the model page, click Get API Key in the right pane.
  4. If prompted, complete Developer Program sign in, then click Generate Key.
  5. Copy the key that starts with nvapi- and paste it below.

 Official quickstart:
  $NIM_DOCS_URL

 Tip:
  Type pulsarcode /api whenever you want to replace the stored key.
  Inside the isolated Claude Code profile, the local /api command is installed
  and routes back to this same setup panel when custom commands are available.
+------------------------------------------------------------------------------+
API_PANEL
}

store_nim_key_interactive() {
    local reason="${1:-manual update}"
    local existing=""
    local key=""
    local confirm=""
    print_api_panel "$reason"
    if [[ ! -t 0 ]]; then
        cat <<'NO_TTY' >&2
pulsarcode: this shell cannot accept hidden input.
Run this in a normal terminal tab:
  pulsarcode /api
NO_TTY
        return 2
    fi
    existing="$(current_nim_key 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then
        # FIXED BY Claude 2026-05-20 (Rung 1B+): credit-rotation hint.
        cat <<'ROTATE_HINT' >&2
  Tip: if you hit your 1000-credit limit, you need a NEW NVIDIA account.
       Free credits do not reset on the same account for ~30 days. Sign up
       with a fresh email at https://build.nvidia.com and paste that account's
       key here. Gmail aliases like you+nim2@gmail.com count as separate
       accounts on most signup forms.

ROTATE_HINT
        printf '%s' "Replace stored key now? [y/N] " >&2
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES) ;;
            *)
                export NVIDIA_NIM_API_KEY="$existing"
                export NVIDIA_NIM_KEY="${NVIDIA_NIM_KEY:-$existing}"
                export NVIDIA_API_KEY="${NVIDIA_API_KEY:-$existing}"
                printf '%s\n' "pulsarcode: keeping existing NVIDIA NIM key." >&2
                return 0
                ;;
        esac
    fi
    if command -v open >/dev/null 2>&1; then
        printf '%s' "Open the NVIDIA Kimi K2.6 model page now? [Y/n] " >&2
        read -r confirm
        case "$confirm" in
            n|N|no|NO) ;;
            *) open "$NIM_MODEL_URL" >/dev/null 2>&1 || true ;;
        esac
    fi
    printf '%s' "Paste NVIDIA NIM API key: " >&2
    read -r -s key
    printf '\n' >&2
    key="${key//$'\r'/}"
    key="${key//$'\n'/}"
    if [[ -z "$key" ]]; then
        printf '%s\n' "pulsarcode: no key entered." >&2
        return 2
    fi
    if [[ "$key" != nvapi-* ]]; then
        printf '%s' "This does not look like an nvapi- key. Store it anyway? [y/N] " >&2
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES) ;;
            *) printf '%s\n' "pulsarcode: key not stored." >&2; return 2 ;;
        esac
    fi
    mkdir -p "$PULSAR_HOME"
    chmod 700 "$PULSAR_HOME" 2>/dev/null || true
    umask 077
    printf '%s\n' "$key" > "$NIM_KEY_FILE"
    chmod 600 "$NIM_KEY_FILE" 2>/dev/null || true
    export NVIDIA_NIM_API_KEY="$key"
    export NVIDIA_NIM_KEY="${NVIDIA_NIM_KEY:-$key}"
    export NVIDIA_API_KEY="${NVIDIA_API_KEY:-$key}"
    printf '%s\n' "pulsarcode: key stored. Future launches use NVIDIA NIM automatically." >&2
    printf '%s\n' "pulsarcode: next prompt will validate the key through the local adapter." >&2
}

load_nim_key() {
    local key=""
    install_api_slash_command
    if [[ -n "${NVIDIA_NIM_API_KEY:-}" ]]; then
        export NVIDIA_NIM_KEY="${NVIDIA_NIM_KEY:-$NVIDIA_NIM_API_KEY}"
        export NVIDIA_API_KEY="${NVIDIA_API_KEY:-$NVIDIA_NIM_API_KEY}"
        return 0
    fi
    if [[ -n "${NVIDIA_NIM_KEY:-}" ]]; then
        export NVIDIA_NIM_API_KEY="$NVIDIA_NIM_KEY"
        export NVIDIA_API_KEY="${NVIDIA_API_KEY:-$NVIDIA_NIM_KEY}"
        return 0
    fi
    if [[ -n "${NVIDIA_API_KEY:-}" ]]; then
        export NVIDIA_NIM_API_KEY="$NVIDIA_API_KEY"
        export NVIDIA_NIM_KEY="${NVIDIA_NIM_KEY:-$NVIDIA_API_KEY}"
        return 0
    fi
    if [[ -f "$NIM_KEY_FILE" ]]; then
        key="$(tr -d '\r\n' < "$NIM_KEY_FILE")"
        if [[ -n "$key" ]]; then
            export NVIDIA_NIM_API_KEY="$key"
            export NVIDIA_NIM_KEY="${NVIDIA_NIM_KEY:-$key}"
            export NVIDIA_API_KEY="${NVIDIA_API_KEY:-$key}"
            return 0
        fi
    fi
    store_nim_key_interactive "missing NVIDIA NIM key"
}

ensure_phsl_up() {
    if phsl_alive; then return 0; fi
    echo "pulsarcode: PHSL down, starting it ..." >&2
    bash "${PROJECT_DIR}/scripts/start_pulsar_stack.sh" >/dev/null 2>&1 || true
    for i in $(seq 1 60); do sleep 2; if phsl_alive; then return 0; fi; done
    echo "pulsarcode: PHSL did not come up at ${PHSL_BASE}." >&2
    return 2
}

ensure_fast_up() {
    if fast_alive; then return 0; fi
    echo "pulsarcode: mlx-lm Qwen backend down, starting it ..." >&2
    bash "${PROJECT_DIR}/scripts/start_fast_backend.sh" >/dev/null 2>&1 || true
    for i in $(seq 1 60); do sleep 2; if fast_alive; then return 0; fi; done
    echo "pulsarcode: mlx-lm Qwen backend did not come up at ${FAST_BASE}." >&2
    return 2
}

ensure_litellm_up() {
    local litellm_pid=""
    local log_target="$LITELLM_LOG_FILE"
    if litellm_alive; then return 0; fi
    if [[ ! -x "$PULSAR_VENV/bin/python" ]]; then
        echo "pulsarcode: venv python not found at $PULSAR_VENV/bin/python." >&2
        return 2
    fi
    if [[ "$log_target" != "/dev/null" ]]; then
        if ! mkdir -p "$(dirname "$log_target")" 2>/dev/null || ! : >> "$log_target" 2>/dev/null; then
            echo "pulsarcode: warning: could not write LiteLLM log file at $log_target; using /dev/null." >&2
            log_target="/dev/null"
        fi
    fi
    echo "pulsarcode: NIM adapter down, starting it for NVIDIA NIM Kimi K2.6 ..." >&2
    PYTHONPATH="$PROJECT_DIR" \
        nohup "$PULSAR_VENV/bin/python" "$PROJECT_DIR/proxy/nim_anthropic_proxy.py" \
            --host "$LITELLM_HOST" --port "$LITELLM_PORT" \
            --model "$NIM_MODEL_ID" --public-model "$NIM_PUBLIC_MODEL" \
            --api-base "$NIM_API_BASE" \
        > "$log_target" 2>&1 &
    litellm_pid=$!
    if mkdir -p "$(dirname "$LITELLM_PID_FILE")" 2>/dev/null; then
        if ! printf '%s\n' "$litellm_pid" > "$LITELLM_PID_FILE" 2>/dev/null; then
            echo "pulsarcode: warning: could not write NIM adapter pid file at $LITELLM_PID_FILE; continuing." >&2
        fi
    else
        echo "pulsarcode: warning: could not create NIM adapter pid directory for $LITELLM_PID_FILE; continuing." >&2
    fi
    for i in $(seq 1 60); do
        sleep 1
        if litellm_alive; then return 0; fi
    done
    echo "pulsarcode: NIM adapter did not come up at ${LITELLM_BASE}." >&2
    if [[ "$log_target" != "/dev/null" ]]; then
        echo "pulsarcode: check $log_target" >&2
    else
        echo "pulsarcode: set PULSAR_NIM_PROXY_LOG_FILE to capture startup logs if disk space allows." >&2
    fi
    return 2
}

