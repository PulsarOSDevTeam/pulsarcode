#
# pulsarcode  -  sovereign Claude Code launcher (NVIDIA NIM backend)
# =================================================================
#
# Bring your own free NVIDIA NIM API key. Pick any model from the live
# API Sonar catalog (55+ frontier coding models). Get Claude Code's exact
# UX with the model layer swapped to whichever NIM route you chose.
#
# Three numbered steps on first launch:
#   1. NVIDIA NIM API key paste (free, 1000 credits, no card).
#   2. Arrow-key model picker (or numbered fallback on Windows).
#   3. Claude Code opens with your model wired in.
#
# Four managed slash commands installed into an isolated Claude Code
# profile so they cannot leak into your personal claude config:
#     /api      paste / replace your NVIDIA NIM key
#     /sonar    list the live NIM model catalog
#     /pick     arrow-key model picker (fresh terminal tab)
#     /model    persist a different alias for the next launch
#
# Zero telemetry, zero phone-home, zero non-local network traffic
# beyond the bearer-authenticated HTTPS request to NVIDIA NIM.
#
# Operators provide the official Claude Code CLI separately
# (https://claude.com/claude-code). This script wraps it, it does not
# redistribute it.

set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
SELF_DIR="$(dirname "$SELF")"
if [[ -d "$SELF_DIR/../proxy" ]]; then
    PROJECT_DIR="$(cd "$SELF_DIR/.." && pwd)"
elif [[ -d "$SELF_DIR/proxy" ]]; then
    PROJECT_DIR="$(cd "$SELF_DIR" && pwd)"
else
    PROJECT_DIR="$(cd "$SELF_DIR/.." && pwd)"
fi

PULSAR_HOME="${PULSAR_HOME:-$HOME/.pulsarcode}"
mkdir -p "$PULSAR_HOME/claude_config" 2>/dev/null || true
chmod 700 "$PULSAR_HOME" 2>/dev/null || true

# Locate the official Claude Code binary the operator installed separately.
CLAUDE_BIN=""
for cand in "$HOME/.local/bin/claude" "$HOME/.claude/bin/claude" "/usr/local/bin/claude" "/opt/homebrew/bin/claude"; do
    if [[ -x "$cand" ]]; then CLAUDE_BIN="$cand"; break; fi
done
if [[ -z "$CLAUDE_BIN" ]]; then CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"; fi

# Locate the Python virtualenv created by install.sh.
if [[ -z "${PULSAR_VENV:-}" ]]; then
    PULSAR_VENV="$HOME/.pulsarcode/venv"
fi

# Wire defaults. All overridable via env so the operator can point at
# enterprise NIM, a self-hosted proxy, or a different default model.
NIM_HOST="${PULSAR_NIM_ADAPTER_HOST:-127.0.0.1}"
NIM_PORT="${PULSAR_NIM_ADAPTER_PORT:-4000}"
NIM_BASE="http://${NIM_HOST}:${NIM_PORT}"
NIM_API_BASE="${NVIDIA_NIM_API_BASE:-https://integrate.api.nvidia.com/v1}"
NIM_MODEL_DEFAULT="${PULSAR_NIM_MODEL:-moonshotai/kimi-k2.6}"
NIM_PUBLIC_DEFAULT="${PULSAR_NIM_PUBLIC_MODEL:-nim-kimi}"
NIM_MODEL_URL="${PULSAR_NIM_MODEL_URL:-https://build.nvidia.com/moonshotai/kimi-k2.6}"
NIM_DOCS_URL="${PULSAR_NIM_DOCS_URL:-https://docs.api.nvidia.com/nim/docs/api-quickstart}"

NIM_KEY_FILE="${PULSAR_NIM_KEY_FILE:-$PULSAR_HOME/nim.key}"
ACTIVE_MODEL_FILE="${PULSAR_ACTIVE_MODEL_FILE:-$PULSAR_HOME/active_model}"
ONBOARDING_SENTINEL="${PULSAR_ONBOARDING_SENTINEL:-$PULSAR_HOME/onboarding_complete}"
PULSAR_RUN_DIR="${PULSAR_RUN_DIR:-$PULSAR_HOME/run}"
NIM_PID_FILE="$PULSAR_RUN_DIR/nim-adapter.pid"
NIM_LOG_FILE="${PULSAR_NIM_PROXY_LOG_FILE:-/dev/null}"

mkdir -p "$PULSAR_RUN_DIR" 2>/dev/null || true

NIM_MODEL_ID="$NIM_MODEL_DEFAULT"
NIM_PUBLIC_MODEL="$NIM_PUBLIC_DEFAULT"

# ---------- helpers ----------

nim_alive() { curl -s -o /dev/null -m 3 -w "%{http_code}" "${NIM_BASE}/v1/models" 2>/dev/null | grep -q '^2'; }

current_nim_key() {
    if [[ -n "${NVIDIA_NIM_API_KEY:-}" ]]; then printf '%s' "$NVIDIA_NIM_API_KEY"; return 0; fi
    if [[ -n "${NVIDIA_NIM_KEY:-}" ]]; then printf '%s' "$NVIDIA_NIM_KEY"; return 0; fi
    if [[ -n "${NVIDIA_API_KEY:-}" ]]; then printf '%s' "$NVIDIA_API_KEY"; return 0; fi
    if [[ -f "$NIM_KEY_FILE" ]]; then tr -d '\r\n' < "$NIM_KEY_FILE"; return 0; fi
    return 1
}

mask_key_source() {
    local key="$1"
    if (( ${#key} <= 12 )); then printf 'present'; return 0; fi
    printf '%s...%s' "${key:0:8}" "${key: -4}"
}

read_active_alias() {
    if [[ -f "$ACTIVE_MODEL_FILE" ]]; then tr -d '\r\n' < "$ACTIVE_MODEL_FILE"; fi
}

resolve_alias_to_upstream() {
    local alias="$1"
    if [[ -z "$alias" || ! -x "$PULSAR_VENV/bin/python" ]]; then return 1; fi
    PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" - "$alias" <<'PY' 2>/dev/null
import os
import sys
from proxy.nim_api_sonar import (
    DEFAULT_API_BASE,
    DEFAULT_PUBLIC_MODEL,
    resolve_model_alias,
)

key = (
    os.environ.get("NVIDIA_NIM_API_KEY")
    or os.environ.get("NVIDIA_API_KEY")
    or os.environ.get("NVIDIA_NIM_KEY")
    or ""
)
api_base = os.environ.get("NVIDIA_NIM_API_BASE", DEFAULT_API_BASE)
public_default = os.environ.get("PULSAR_NIM_PUBLIC_MODEL", DEFAULT_PUBLIC_MODEL)
print(resolve_model_alias(sys.argv[1], api_base=api_base, api_key=key, public_default=public_default))
PY
}

apply_active_model() {
    local alias
    alias="$(read_active_alias 2>/dev/null || true)"
    if [[ -z "$alias" ]]; then return 0; fi
    local upstream
    upstream="$(resolve_alias_to_upstream "$alias" 2>/dev/null || true)"
    if [[ -n "$upstream" && "$upstream" != "None" ]]; then
        NIM_MODEL_ID="$upstream"
        NIM_PUBLIC_MODEL="$alias"
        export PULSAR_NIM_MODEL="$NIM_MODEL_ID"
        export PULSAR_NIM_PUBLIC_MODEL="$NIM_PUBLIC_MODEL"
    fi
}

print_api_panel() {
    local reason="${1:-manual update}"
    local key_state="not stored"
    local existing
    existing="$(current_nim_key 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then key_state="$(mask_key_source "$existing")"; fi
    cat <<API_PANEL >&2

+------------------------------------------------------------------------------+
| pulsarcode API key panel                                                     |
| NVIDIA NIM key setup                                                         |
+------------------------------------------------------------------------------+
 Trigger          : $reason
 Runtime model    : $NIM_MODEL_ID
 Local alias      : $NIM_PUBLIC_MODEL
 API endpoint     : $NIM_API_BASE/chat/completions
 Stored key       : $key_state
 Key file         : $NIM_KEY_FILE

 Steps:
  1. Open $NIM_MODEL_URL
  2. Sign in. If you do not have an NVIDIA account, create one from that page.
  3. On the model page, click Get API Key in the right pane.
  4. If prompted, complete the Developer Program sign-in, then click Generate Key.
  5. Copy the key that starts with nvapi- and paste it below.

 Official NVIDIA NIM quickstart:
  $NIM_DOCS_URL

 Tip:
  Run pulsarcode /api any time you want to replace the stored key.
+------------------------------------------------------------------------------+
API_PANEL
}

store_nim_key_interactive() {
    local reason="${1:-manual update}"
    local existing="" key="" confirm=""
    print_api_panel "$reason"
    if [[ ! -t 0 ]]; then
        echo "pulsarcode: this shell cannot accept hidden input." >&2
        echo "  Run this in a normal terminal tab: pulsarcode /api" >&2
        return 2
    fi
    existing="$(current_nim_key 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then
        cat <<'ROTATE_HINT' >&2
  Tip: if your key is rate-limited or out of credits, sign in to
       https://build.nvidia.com to review your account quota and the
       paid plans NVIDIA offers alongside the free developer tier.
       Once you have a new key, paste it below.

ROTATE_HINT
        printf '%s' "Replace stored key now? [y/N] " >&2
        read -r confirm
        case "$confirm" in
            y|Y|yes|YES) ;;
            *)
                export NVIDIA_NIM_API_KEY="$existing"
                echo "pulsarcode: keeping existing key." >&2
                return 0
                ;;
        esac
    fi
    if command -v open >/dev/null 2>&1; then
        printf '%s' "Open the NVIDIA NIM model page now? [Y/n] " >&2
        read -r confirm
        case "$confirm" in n|N|no|NO) ;; *) open "$NIM_MODEL_URL" >/dev/null 2>&1 || true ;; esac
    fi
    printf '%s' "Paste NVIDIA NIM API key: " >&2
    read -r -s key
    printf '\n' >&2
    key="${key//$'\r'/}"; key="${key//$'\n'/}"
    if [[ -z "$key" ]]; then echo "pulsarcode: no key entered." >&2; return 2; fi
    if [[ "$key" != nvapi-* ]]; then
        printf '%s' "This does not look like an nvapi- key. Store anyway? [y/N] " >&2
        read -r confirm
        case "$confirm" in y|Y|yes|YES) ;; *) echo "pulsarcode: key not stored." >&2; return 2 ;; esac
    fi
    chmod 700 "$PULSAR_HOME" 2>/dev/null || true
    umask 077
    printf '%s\n' "$key" > "$NIM_KEY_FILE"
    chmod 600 "$NIM_KEY_FILE" 2>/dev/null || true
    export NVIDIA_NIM_API_KEY="$key"
    echo "pulsarcode: key stored. Future launches use NVIDIA NIM automatically." >&2
}

load_nim_key() {
    local key=""
    install_slash_commands
    if [[ -n "${NVIDIA_NIM_API_KEY:-}" ]]; then return 0; fi
    if [[ -n "${NVIDIA_NIM_KEY:-}" ]]; then export NVIDIA_NIM_API_KEY="$NVIDIA_NIM_KEY"; return 0; fi
    if [[ -n "${NVIDIA_API_KEY:-}" ]]; then export NVIDIA_NIM_API_KEY="$NVIDIA_API_KEY"; return 0; fi
    if [[ -f "$NIM_KEY_FILE" ]]; then
        key="$(tr -d '\r\n' < "$NIM_KEY_FILE")"
        if [[ -n "$key" ]]; then export NVIDIA_NIM_API_KEY="$key"; return 0; fi
    fi
    store_nim_key_interactive "missing NVIDIA NIM key"
}

ensure_nim_adapter_up() {
    if nim_alive; then return 0; fi
    if [[ ! -x "$PULSAR_VENV/bin/python" ]]; then
        echo "pulsarcode: venv python not found at $PULSAR_VENV/bin/python." >&2
        return 2
    fi
    echo "pulsarcode: NIM adapter not running, starting it ..." >&2
    PYTHONPATH="$PROJECT_DIR" \
        nohup "$PULSAR_VENV/bin/python" "$PROJECT_DIR/proxy/nim_anthropic_proxy.py" \
            --host "$NIM_HOST" --port "$NIM_PORT" \
            --model "$NIM_MODEL_ID" --public-model "$NIM_PUBLIC_MODEL" \
            --api-base "$NIM_API_BASE" \
        > "$NIM_LOG_FILE" 2>&1 &
    printf '%s\n' "$!" > "$NIM_PID_FILE" 2>/dev/null || true
    for _ in $(seq 1 60); do
        sleep 1
        if nim_alive; then return 0; fi
    done
    echo "pulsarcode: NIM adapter did not come up at $NIM_BASE." >&2
    return 2
}

_write_managed_command() {
    local file="$1"
    if [[ -f "$file" ]] && ! grep -q "Managed by pulsarcode" "$file" 2>/dev/null; then return 0; fi
    cat > "$file"
}

install_slash_commands() {
    local d="$PULSAR_HOME/claude_config/commands"
    mkdir -p "$d" 2>/dev/null || return 0
    _write_managed_command "$d/api.md" <<'API_CMD'
---
description: Open the pulsarcode NVIDIA NIM API key setup panel.
allowed-tools: Bash
argument-hint: [check]
---

Run the local setup panel and print its output:

```bash
pulsarcode /api
```

If this shell cannot accept terminal input, tell the operator to run `pulsarcode /api` in a normal terminal tab.

Managed by pulsarcode.
API_CMD
    _write_managed_command "$d/sonar.md" <<'SONAR_CMD'
---
description: Show the NVIDIA NIM model catalog exposed through pulsarcode API Sonar.
allowed-tools: Bash
argument-hint: [filter]
---

Run the catalog command and print its output:

```bash
pulsarcode sonar
```

Two ways to switch model:
  Live (this session only): use Claude Code's built-in `/model` picker.
  Persisted (next launch onwards): run `/model <alias>` (this custom command).

For the arrow-key interactive picker, open a fresh terminal tab and run `pulsarcode pick`.

Managed by pulsarcode.
SONAR_CMD
    _write_managed_command "$d/pick.md" <<'PICK_CMD'
---
description: Launch the pulsarcode arrow-key model picker (fresh terminal tab).
allowed-tools: Bash
argument-hint: []
---

Tell the operator to open a fresh terminal tab and run:

```bash
pulsarcode pick
```

The picker is keyboard-driven and cannot run inside a Claude Code session.

Managed by pulsarcode.
PICK_CMD
    _write_managed_command "$d/model.md" <<'MODEL_CMD'
---
description: Persist the pulsarcode active model alias for the next launch (sticky).
allowed-tools: Bash
argument-hint: <alias>
---

Run the persist command and print its output:

```bash
pulsarcode model "$ARGUMENTS"
```

This is the STICKY model selection. Writes the alias to `~/.pulsarcode/active_model`. For a LIVE in-session switch, use Claude Code's built-in `/model` picker instead.

Managed by pulsarcode.
MODEL_CMD
}

maybe_run_first_launch_wizard() {
    if [[ -f "$ONBOARDING_SENTINEL" ]]; then return 0; fi
    if [[ ! -t 0 ]] || [[ ! -t 2 ]]; then return 0; fi
    if [[ ! -x "$PULSAR_VENV/bin/python" ]]; then
        echo "pulsarcode: venv python missing at $PULSAR_VENV/bin/python. Skipping wizard." >&2
        return 0
    fi
    cat <<'WELCOME' >&2

+----------------------------------------------------------------------------+
| Welcome to pulsarcode                                                      |
| Sovereign Claude Code launcher, your choice of model                       |
+----------------------------------------------------------------------------+

 First-launch setup, three numbered steps:

   1. Generate an NVIDIA NIM API key (free, 1000 credits, no card required).
   2. Pick a model from the live API Sonar catalog using the arrow keys.
   3. Launch Claude Code with your chosen model, ready to code.

 You can switch model anytime later:
   /model <alias>    inside a session  (persists for next launch)
   pulsarcode pick   in a fresh terminal  (arrow-key picker)

WELCOME
    install_slash_commands
    echo "" >&2
    echo " Step 1 of 3: NVIDIA NIM API key" >&2
    echo " --------------------------------" >&2
    if ! store_nim_key_interactive "first launch wizard"; then
        cat <<'KEY_SKIP' >&2

 Key setup did not complete. Run `pulsarcode /api` whenever you are ready.

KEY_SKIP
        return 0
    fi
    echo "" >&2
    echo " Step 2 of 3: pick a model from API Sonar" >&2
    echo " -----------------------------------------" >&2
    echo " Arrow keys to move, Enter to select, Esc to keep the default." >&2
    echo "" >&2
    local key
    key="$(current_nim_key 2>/dev/null || true)"
    if [[ -n "$key" ]]; then export NVIDIA_NIM_API_KEY="$key"; fi
    PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" -m proxy.nim_sonar_picker \
        --api-base "$NIM_API_BASE" \
        --public-model "$NIM_PUBLIC_MODEL" || true
    touch "$ONBOARDING_SENTINEL" 2>/dev/null || true
    chmod 600 "$ONBOARDING_SENTINEL" 2>/dev/null || true
    cat <<'DONE' >&2

 Step 3 of 3: launching Claude Code

DONE
}

print_help() {
    cat <<HELP
pulsarcode  -  sovereign Claude Code launcher

Bring your own free NVIDIA NIM API key. Pick any model from the live
catalog. Get Claude Code's exact UX with the model layer swapped to
whichever NIM route you chose. AGPL-3.0, free forever, no telemetry.

Default:

  pulsarcode      Same UX as Claude Code, ANTHROPIC_BASE_URL points to a
                  local NIM adapter at 127.0.0.1:4000. Routes to whichever
                  NIM alias you picked via 'pulsarcode pick'. First launch
                  runs the setup wizard.

Setup / selection subcommands:

  /api            NVIDIA NIM API key setup panel. Use once on first launch,
                  or any time you want to replace the stored key.

  sonar           Print the full live NVIDIA NIM model catalog (table form).

  pick            Arrow-key interactive picker over the Sonar catalog.
                  Run in a fresh terminal tab. Writes the choice to
                  ~/.pulsarcode/active_model. Next launch inherits.

  model              Print the current active model alias.
  model <alias>      Set the active model alias for the next launch.

Observability:

  status          Stack health, active model, NIM key state.
  help            This help.

Routing guarantees:
  pulsarcode never modifies your system claude binary or your ~/.claude
  profile. Runs from ~/.pulsarcode/claude_config (isolated). No telemetry,
  no autoupdater, no error-reporting traffic. The only outbound network
  call is the bearer-authenticated HTTPS request to NVIDIA NIM.

License: AGPL-3.0-or-later. https://github.com/PulsarOSDevTeam/pulsarcode

HELP
}

# ---------- subcommand dispatch ----------

ARG1="${1:-}"
KNOWN_SUBS="status help api /api --api key sonar pick select sonar-pick model"
if [[ -z "$ARG1" ]] || [[ "$ARG1" == -* ]] || [[ ! " $KNOWN_SUBS " == *" $ARG1 "* ]]; then
    SUB="launch"
    AUTO_MODE=1
else
    SUB="$ARG1"
    AUTO_MODE=0
fi

case "$SUB" in
    launch)
        maybe_run_first_launch_wizard
        ;;
esac

case "$SUB" in
    help|-h|--help)
        print_help
        exit 0
        ;;
    status)
        install_slash_commands
        apply_active_model
        echo "pulsarcode stack status"
        echo "  Default command: pulsarcode -> NVIDIA NIM ($NIM_PUBLIC_MODEL)"
        if [[ -f "$ACTIVE_MODEL_FILE" ]]; then
            echo "  Active model    : $(read_active_alias)  ->  $NIM_MODEL_ID"
            echo "  Source          : ~/.pulsarcode/active_model (operator picked)"
        else
            echo "  Active model    : $NIM_PUBLIC_MODEL  ->  $NIM_MODEL_ID"
            echo "  Source          : default (no operator selection yet)"
        fi
        if [[ -f "$ONBOARDING_SENTINEL" ]]; then
            echo "  Onboarding      : completed"
        else
            echo "  Onboarding      : pending (wizard runs on next 'pulsarcode')"
        fi
        echo "  NIM adapter @ $NIM_BASE/v1/models    $(nim_alive && echo OK || echo DOWN)"
        if [[ -n "${NVIDIA_NIM_API_KEY:-}${NVIDIA_NIM_KEY:-}${NVIDIA_API_KEY:-}" || -f "$NIM_KEY_FILE" ]]; then
            echo "  NIM key         : present"
        else
            echo "  NIM key         : not found -> run 'pulsarcode /api'"
        fi
        echo "  API setup panel : pulsarcode /api"
        exit 0
        ;;
    api|/api|--api|key)
        install_slash_commands
        store_nim_key_interactive "manual /api request"
        exit $?
        ;;
    sonar)
        install_slash_commands
        key="$(current_nim_key 2>/dev/null || true)"
        if [[ -n "$key" ]]; then export NVIDIA_NIM_API_KEY="$key"; fi
        PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" -m proxy.nim_api_sonar \
            --api-base "$NIM_API_BASE" \
            --public-model "$NIM_PUBLIC_MODEL"
        exit $?
        ;;
    pick|select|sonar-pick)
        install_slash_commands
        key="$(current_nim_key 2>/dev/null || true)"
        if [[ -z "$key" ]]; then
            echo "pulsarcode: no NVIDIA NIM key found. Run 'pulsarcode /api' first." >&2
            exit 2
        fi
        export NVIDIA_NIM_API_KEY="$key"
        PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" -m proxy.nim_sonar_picker \
            --api-base "$NIM_API_BASE" \
            --public-model "$NIM_PUBLIC_MODEL"
        rc=$?
        if [[ $rc -eq 0 ]]; then
            current="$(read_active_alias 2>/dev/null || true)"
            if [[ -n "$current" ]]; then
                echo "pulsarcode: next 'pulsarcode' will route to $current." >&2
            fi
        fi
        exit $rc
        ;;
    model)
        install_slash_commands
        if [[ -z "${2:-}" ]]; then
            current="$(read_active_alias 2>/dev/null || true)"
            if [[ -n "$current" ]]; then
                echo "pulsarcode: active model is $current."
                echo "Run 'pulsarcode sonar' to see the catalog or 'pulsarcode pick' for the picker."
            else
                echo "pulsarcode: no active model selected yet."
                echo "Run 'pulsarcode pick' to choose, or 'pulsarcode model <alias>' to set directly."
            fi
            exit 0
        fi
        target="$2"
        key="$(current_nim_key 2>/dev/null || true)"
        if [[ -n "$key" ]]; then export NVIDIA_NIM_API_KEY="$key"; fi
        upstream="$(resolve_alias_to_upstream "$target" 2>/dev/null || true)"
        if [[ -z "$upstream" || "$upstream" == "None" ]]; then
            echo "pulsarcode: alias '$target' not recognized in the current Sonar catalog." >&2
            echo "  Run 'pulsarcode sonar' to see valid aliases." >&2
            exit 64
        fi
        if ! PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" - "$target" <<'PY'
import sys
from proxy.nim_sonar_picker import write_active_model
write_active_model(sys.argv[1])
PY
        then
            echo "pulsarcode: failed to persist active model." >&2
            exit 1
        fi
        echo "pulsarcode: active model set to $target ($upstream)."
        echo "Next 'pulsarcode' launch will route there automatically."
        exit 0
        ;;
    launch)
        if [[ -z "$CLAUDE_BIN" ]]; then
            echo "pulsarcode: Claude Code binary not found." >&2
            echo "  Install it from https://claude.com/claude-code" >&2
            exit 127
        fi
        load_nim_key
        apply_active_model
        ensure_nim_adapter_up
        BACKEND_URL="$NIM_BASE"
        ACTIVE_MODEL="$NIM_PUBLIC_MODEL"
        cat <<BANNER >&2
========================================================================
 pulsarcode  -  sovereign Claude Code  (NVIDIA NIM backend)
========================================================================
 backend         : NIM adapter @ $NIM_BASE
 model           : $NIM_PUBLIC_MODEL  ->  $NIM_MODEL_ID
 config dir      : $PULSAR_HOME/claude_config (isolated)
 retry/timeout   : ANTHROPIC_MAX_RETRIES=0, ANTHROPIC_TIMEOUT=3600
 license         : AGPL-3.0-or-later, free forever
========================================================================
BANNER
        ;;
    *)
        echo "pulsarcode: unknown subcommand '$SUB'." >&2
        echo "  run 'pulsarcode help' for available modes." >&2
        exit 64
        ;;
esac

# ---------- launch Claude Code through the NIM adapter ----------

export CLAUDE_CONFIG_DIR="$PULSAR_HOME/claude_config"
export ANTHROPIC_BASE_URL="$BACKEND_URL"
export ANTHROPIC_AUTH_TOKEN="${PULSAR_AUTH_TOKEN:-local-pulsar-dev}"
unset ANTHROPIC_API_KEY
export ANTHROPIC_MODEL="$ACTIVE_MODEL"
export ANTHROPIC_MAX_RETRIES=0
export ANTHROPIC_TIMEOUT=3600
export ANTHROPIC_REQUEST_TIMEOUT=3600
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_AUTOUPDATER=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_BUG_COMMAND=1
export DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
export DISABLE_COST_WARNINGS=1
export CLAUDE_CODE_USE_BEDROCK=0
export CLAUDE_CODE_USE_VERTEX=0

if [[ "$AUTO_MODE" -eq 0 ]]; then shift; fi
exec "$CLAUDE_BIN" "$@"
