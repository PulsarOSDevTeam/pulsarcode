    export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="NVIDIA NIM Kimi K2 instruct route through API Sonar"
    export ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES="tools,streaming"
    export ANTHROPIC_SMALL_FAST_MODEL="$NIM_SELECTOR_CODER_MODEL"
    export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
else
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$ACTIVE_MODEL"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$ACTIVE_MODEL"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ACTIVE_MODEL"
    export ANTHROPIC_SMALL_FAST_MODEL="$ACTIVE_MODEL"
fi

export ANTHROPIC_MAX_RETRIES=0
export ANTHROPIC_TIMEOUT=3600
export ANTHROPIC_REQUEST_TIMEOUT=3600

export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_AUTOUPDATER=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_BUG_COMMAND=1
export DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
export DISABLE_COST_WARNINGS=1
export CLAUDE_CODE_USE_BEDROCK=0
export CLAUDE_CODE_USE_VERTEX=0

# Only shift away the first arg if it was actually a subcommand we consumed.
# In AUTO_MODE, $1 is the first claude flag (e.g. --version, -p) and must
# stay in the argv we forward.
if [[ "$AUTO_MODE" -eq 0 ]]; then
    shift
fi
if [[ "$SUB" == "nim" || "$SUB" == "nvidia" ]]; then
    if [[ "${PULSAR_NIM_MODEL_SETTINGS:-1}" != "0" ]] && ! args_have_settings "$@"; then
        nim_model_settings_file="$(write_nim_model_settings 2>/dev/null || true)"
        if [[ -n "$nim_model_settings_file" ]]; then
            set -- --settings "$nim_model_settings_file" "$@"
        fi
    fi
fi
exec "${CLAUDE_BIN}" "$@"
