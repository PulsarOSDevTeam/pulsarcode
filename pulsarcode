set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
# FIXED BY Claude 2026-05-20 (Rung 1B): layout-flexible PROJECT_DIR.
# Canonical layout : <root>/cli/pulsarcode with sibling <root>/proxy/
# Team-dist layout : <root>/pulsarcode      with sibling <root>/proxy/
# The installer places the symlink-target launcher at one of these two paths.
# We auto-detect by checking which sibling of the script directory holds proxy/.
SELF_DIR="$(dirname "$SELF")"
if [[ -d "$SELF_DIR/../proxy" ]]; then
    PROJECT_DIR="$(cd "$SELF_DIR/.." && pwd)"
elif [[ -d "$SELF_DIR/proxy" ]]; then
    PROJECT_DIR="$(cd "$SELF_DIR" && pwd)"
else
    PROJECT_DIR="$(cd "$SELF_DIR/.." && pwd)"
fi
PULSAR_HOME="${PULSAR_HOME:-$HOME/.pulsarcode}"
mkdir -p "$PULSAR_HOME/claude_config"

CLAUDE_BIN=""
for cand in "$HOME/.local/bin/claude" "$HOME/.claude/bin/claude" "/usr/local/bin/claude" "/opt/homebrew/bin/claude"; do
    if [[ -x "$cand" ]]; then CLAUDE_BIN="$cand"; break; fi
done
if [[ -z "$CLAUDE_BIN" ]]; then CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"; fi
if [[ -z "$CLAUDE_BIN" ]]; then
    echo "pulsarcode: no Claude Code binary found." >&2
    exit 127
fi

PHSL_BASE="${PULSAR_PHSL_BASE:-http://127.0.0.1:8000}"
FAST_BASE="${PULSAR_FAST_BASE:-http://127.0.0.1:8001}"
KIMI_ROOT="${PULSAR_ROOT:-/Volumes/PulsarOS/kimi-k2_6}"
LITELLM_HOST="${PULSAR_LITELLM_HOST:-127.0.0.1}"
LITELLM_PORT="${PULSAR_LITELLM_PORT:-4000}"
LITELLM_BASE="${PULSAR_LITELLM_BASE:-http://${LITELLM_HOST}:${LITELLM_PORT}}"
LITELLM_CONFIG="${PROJECT_DIR}/proxy/litellm_config.yaml"
PULSAR_RUN_DIR="${PULSAR_RUN_DIR:-$PULSAR_HOME/run}"
LITELLM_PID_FILE="${PULSAR_LITELLM_PID_FILE:-$PULSAR_RUN_DIR/pulsar-nim-proxy.pid}"
LITELLM_LOG_FILE="${PULSAR_LITELLM_LOG_FILE:-${PULSAR_NIM_PROXY_LOG_FILE:-/dev/null}}"
# FIXED BY Claude 2026-05-20 (Rung 1B): venv path discovery.
# Order of preference:
#   1. $PULSAR_VENV (operator override, e.g. for CI)
#   2. ~/.kimi-local-venv (the operator's canonical install)
#   3. ~/.pulsarcode/venv (the team-distribution install layout)
# When team-dist runs on a teammate's machine, only path 3 exists and is used.
# When the operator runs on his Mac, path 2 wins and his PHSL/Gemma deps stay
# bound to the same venv as before. Both layouts coexist cleanly.
if [[ -z "${PULSAR_VENV:-}" ]]; then
    if [[ -x "$HOME/.kimi-local-venv/bin/python" ]]; then
        PULSAR_VENV="$HOME/.kimi-local-venv"
    elif [[ -x "$HOME/.pulsarcode/venv/bin/python" ]]; then
        PULSAR_VENV="$HOME/.pulsarcode/venv"
    else
        PULSAR_VENV="$HOME/.kimi-local-venv"
    fi
fi
NIM_KEY_FILE="${PULSAR_NIM_KEY_FILE:-$PULSAR_HOME/nim.key}"
NIM_MODEL_ID="${PULSAR_NIM_MODEL:-moonshotai/kimi-k2.6}"
NIM_PUBLIC_MODEL="${PULSAR_NIM_PUBLIC_MODEL:-nim-kimi}"
NIM_SELECTOR_DEFAULT_MODEL="${PULSAR_NIM_SELECTOR_DEFAULT_MODEL:-claude-nim-kimi}"
NIM_SELECTOR_THINKING_MODEL="${PULSAR_NIM_SELECTOR_THINKING_MODEL:-claude-nim-kimi-k2-thinking}"
NIM_SELECTOR_CODER_MODEL="${PULSAR_NIM_SELECTOR_CODER_MODEL:-claude-nim-qwen-qwen3-coder-480b-a35b-instruct}"
NIM_SELECTOR_INSTRUCT_MODEL="${PULSAR_NIM_SELECTOR_INSTRUCT_MODEL:-claude-nim-kimi-k2-instruct}"
NIM_MODEL_URL="${PULSAR_NIM_MODEL_URL:-https://build.nvidia.com/moonshotai/kimi-k2.6}"
NIM_DOCS_URL="${PULSAR_NIM_DOCS_URL:-https://docs.api.nvidia.com/nim/docs/api-quickstart}"
NIM_API_BASE="${NVIDIA_NIM_API_BASE:-https://integrate.api.nvidia.com/v1}"

export PULSAR_NIM_MODEL="$NIM_MODEL_ID"
export PULSAR_NIM_PUBLIC_MODEL="$NIM_PUBLIC_MODEL"
export NVIDIA_NIM_API_BASE="$NIM_API_BASE"

# FIXED BY Claude 2026-05-20 (Rung 1+2): per-operator active-model persistence.
# Picker writes the chosen alias here; every subsequent launch inherits it
# until the operator re-picks via `pulsarcode pick` or `/model <alias>`.
ACTIVE_MODEL_FILE="${PULSAR_ACTIVE_MODEL_FILE:-$PULSAR_HOME/active_model}"
ONBOARDING_SENTINEL="${PULSAR_ONBOARDING_SENTINEL:-$PULSAR_HOME/onboarding_complete}"

read_active_alias() {
    if [[ -f "$ACTIVE_MODEL_FILE" ]]; then
        tr -d '\r\n' < "$ACTIVE_MODEL_FILE"
    fi
}

resolve_alias_to_upstream() {
    local alias="$1"
    if [[ -z "$alias" ]]; then return 1; fi
    if [[ ! -x "$PULSAR_VENV/bin/python" ]]; then return 1; fi
    PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" - "$alias" <<'PY' 2>/dev/null
import os
import sys
from proxy.nim_api_sonar import (
    DEFAULT_API_BASE,
    DEFAULT_PUBLIC_MODEL,
    resolve_model_alias,
)

key = (
    os.environ.get("NVIDIA_NIM_API_KEY")
    or os.environ.get("NVIDIA_API_KEY")
    or os.environ.get("NVIDIA_NIM_KEY")
    or ""
)
api_base = os.environ.get("NVIDIA_NIM_API_BASE", DEFAULT_API_BASE)
public_default = os.environ.get("PULSAR_NIM_PUBLIC_MODEL", DEFAULT_PUBLIC_MODEL)
print(resolve_model_alias(sys.argv[1], api_base=api_base, api_key=key, public_default=public_default))
PY
}

apply_active_model() {
    local alias=""
    alias="$(read_active_alias 2>/dev/null || true)"
    if [[ -z "$alias" ]]; then return 0; fi
    local upstream=""
    upstream="$(resolve_alias_to_upstream "$alias" 2>/dev/null || true)"
    if [[ -n "$upstream" && "$upstream" != "None" ]]; then
        NIM_MODEL_ID="$upstream"
        NIM_PUBLIC_MODEL="$alias"
        NIM_SELECTOR_DEFAULT_MODEL="claude-${alias}"
        export PULSAR_NIM_MODEL="$NIM_MODEL_ID"
        export PULSAR_NIM_PUBLIC_MODEL="$NIM_PUBLIC_MODEL"
        export PULSAR_NIM_SELECTOR_DEFAULT_MODEL="$NIM_SELECTOR_DEFAULT_MODEL"
    fi
}

phsl_alive() { curl -s -o /dev/null -m 3 -w "%{http_code}" "${PHSL_BASE}/healthz" 2>/dev/null | grep -q '^2'; }
fast_alive() { curl -s -o /dev/null -m 3 -w "%{http_code}" "${FAST_BASE}/v1/models" 2>/dev/null | grep -q '^2'; }
litellm_alive() { curl -s -o /dev/null -m 3 -w "%{http_code}" "${LITELLM_BASE}/v1/models" 2>/dev/null | grep -q '^2'; }
litellm_has_nim_model() { curl -s -m 3 "${LITELLM_BASE}/v1/models" 2>/dev/null | grep -q '"id"[[:space:]]*:[[:space:]]*"'"$NIM_SELECTOR_DEFAULT_MODEL"'"'; }
catalog_payload_is_current() {
    local payload
    payload="$(cat)"
    printf '%s' "$payload" | grep -q '"first_id"[[:space:]]*:[[:space:]]*"claude-nim-kimi"' \
        && printf '%s' "$payload" | grep -q '"id"[[:space:]]*:[[:space:]]*"claude-nim-qwen-qwen3-coder-480b-a35b-instruct"' \
        && ! printf '%s' "$payload" | grep -q 'about-nvidia'
}
base_has_current_adapter() {
    local base="$1"
    curl -s -m 3 "${base}/v1/models" 2>/dev/null | catalog_payload_is_current \
        && curl -s -m 3 "${base}/healthz" 2>/dev/null | grep -q '"adapter_protocol"[[:space:]]*:[[:space:]]*"nim-stream-ping-v2"'
}
litellm_has_sonar_catalog() { base_has_current_adapter "$LITELLM_BASE"; }
port_has_sonar_catalog() { base_has_current_adapter "http://${LITELLM_HOST}:$1"; }

port_is_free() {
    local port="$1"
    local py=""
    if [[ -x "$PULSAR_VENV/bin/python" ]]; then
        py="$PULSAR_VENV/bin/python"
    else
        py="$(command -v python3 2>/dev/null || true)"
    fi
    if [[ -z "$py" ]]; then
        return 1
    fi
    "$py" - "$LITELLM_HOST" "$port" <<'PY'
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    sock.bind((host, port))
except OSError:
    sys.exit(1)
finally:
    sock.close()
sys.exit(0)
PY
}

switch_to_fresh_nim_port() {
    local port=""
    for port in $(seq 4001 4010); do
        if port_is_free "$port"; then
            LITELLM_PORT="$port"
            LITELLM_BASE="http://${LITELLM_HOST}:${LITELLM_PORT}"
            LITELLM_PID_FILE="${PULSAR_LITELLM_PID_FILE:-$PULSAR_RUN_DIR/pulsar-nim-proxy-${LITELLM_PORT}.pid}"
            return 0
        fi
    done
    return 1
}

switch_to_existing_sonar_port() {
    local port=""
    for port in $(seq 4001 4010); do
        if port_has_sonar_catalog "$port"; then
            LITELLM_PORT="$port"
            LITELLM_BASE="http://${LITELLM_HOST}:${LITELLM_PORT}"
            LITELLM_PID_FILE="${PULSAR_LITELLM_PID_FILE:-$PULSAR_RUN_DIR/pulsar-nim-proxy-${LITELLM_PORT}.pid}"
            return 0
        fi
    done
    return 1
}

args_have_settings() {
    local arg=""
    for arg in "$@"; do
        if [[ "$arg" == "--settings" || "$arg" == --settings=* ]]; then
            return 0
        fi
    done
    return 1
}

write_nim_model_settings() {
    local settings_file="$PULSAR_RUN_DIR/nim-model-settings-${LITELLM_PORT}.json"
    if [[ ! -x "$PULSAR_VENV/bin/python" ]]; then
        return 1
    fi
    mkdir -p "$PULSAR_RUN_DIR" 2>/dev/null || return 1
    if ! PYTHONPATH="$PROJECT_DIR" "$PULSAR_VENV/bin/python" -m proxy.nim_api_sonar \
        --api-base "$NIM_API_BASE" \
        --public-model "$NIM_PUBLIC_MODEL" \
        --claude-settings > "$settings_file"; then
        return 1
    fi
    chmod 600 "$settings_file" 2>/dev/null || true
    printf '%s' "$settings_file"
}

_write_managed_command() {
    # _write_managed_command <file> <heredoc-payload-on-stdin>
    # Idempotent: writes only if file is missing OR already managed by pulsarcode.
    # Never clobbers an operator-customized file.
    local file="$1"
    if [[ -f "$file" ]] && ! grep -q "Managed by pulsarcode" "$file" 2>/dev/null; then
        return 0
    fi
    cat > "$file"
}

